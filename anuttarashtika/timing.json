[
 {
  "id": "anuttara_01",
  "meter": "shardulavikridita",
  "dur": 22.09,
  "padas": [
   {
    "text": "सङ्क्रामोऽत्र न भावना न च कथायुक्तिर्न चर्चा न च",
    "t_on": 0.0,
    "t_off": 5.522
   },
   {
    "text": "ध्यानं वा न च धारणा न च जपाभ्यासप्रयासो न च ।",
    "t_on": 5.522,
    "t_off": 11.045
   },
   {
    "text": "तत्किं नाम सुनिश्चितं वद परं सत्यं च तच्छ्रूयतां",
    "t_on": 11.045,
    "t_off": 16.567
   },
   {
    "text": "न त्यागी न परिग्रही भज सुखं सर्वं यथावस्थितः ॥",
    "t_on": 16.567,
    "t_off": 22.09
   }
  ]
 },
 {
  "id": "anuttara_02",
  "meter": "shardulavikridita",
  "dur": 21.714,
  "padas": [
   {
    "text": "संसारोऽस्ति न तत्त्वतस्तनुभृतां बन्धस्य वार्तैव का",
    "t_on": 0.0,
    "t_off": 5.501
   },
   {
    "text": "बन्धो यस्य न जातु तस्य वितथा मुक्तस्य मुक्तिक्रिया ।",
    "t_on": 5.501,
    "t_off": 11.002
   },
   {
    "text": "मिथ्यामोहकृदेष रज्जुभुजगच्छायापिशाचभ्रमो",
    "t_on": 11.002,
    "t_off": 16.503
   },
   {
    "text": "मा किञ्चित्त्यज मा गृहाण विलस्वस्थो यथावस्थितः ॥",
    "t_on": 16.503,
    "t_off": 21.714
   }
  ]
 },
 {
  "id": "anuttara_03",
  "meter": "shardulavikridita",
  "dur": 21.874,
  "padas": [
   {
    "text": "पूजापूजकपूज्यभेदसरणिः केयं कथानुत्तरे सङ्क्रामः",
    "t_on": 0.0,
    "t_off": 6.332
   },
   {
    "text": "किल कस्य केन विदधे को वा प्रवेशक्रमः ।",
    "t_on": 6.332,
    "t_off": 10.937
   },
   {
    "text": "मायेयं न चिदद्वयात्परतया भिन्नाप्यहो वर्तते",
    "t_on": 10.937,
    "t_off": 16.405
   },
   {
    "text": "सर्वं स्वानुभवस्वभावविमलं चिन्तां वृथा मा कृथाः ॥",
    "t_on": 16.405,
    "t_off": 21.874
   }
  ]
 },
 {
  "id": "anuttara_04",
  "meter": "shardulavikridita",
  "dur": 22.271,
  "padas": [
   {
    "text": "आनन्दोऽत्र न वित्तमध्यमदवन्नैवाङ्गनासङ्गवत्",
    "t_on": 0.0,
    "t_off": 5.568
   },
   {
    "text": "दीपार्केन्दुकृतप्रभाप्रकरवत् नैव प्रकाशोदयः ।",
    "t_on": 5.568,
    "t_off": 11.136
   },
   {
    "text": "हर्षः सम्भृतभेदमुक्तिसुखभूर्भारावतारोपमः",
    "t_on": 11.136,
    "t_off": 16.703
   },
   {
    "text": "सर्वाद्वैतपदस्य विस्मृतनिधेः प्राप्तिः प्रकाशोदयः ॥",
    "t_on": 16.703,
    "t_off": 22.271
   }
  ]
 },
 {
  "id": "anuttara_05",
  "meter": "shardulavikridita",
  "dur": 21.893,
  "padas": [
   {
    "text": "रागद्वेषसुखासुखोदयलयाहङ्कारदैन्यादयो ये भावाः",
    "t_on": 0.0,
    "t_off": 6.337
   },
   {
    "text": "प्रविभान्ति विश्ववपुषो भिन्नस्वभावा न ते ।",
    "t_on": 6.337,
    "t_off": 10.947
   },
   {
    "text": "व्यक्तिं पश्यसि यस्य यस्य सहसा तत्तत्तदेकात्मता-",
    "t_on": 10.947,
    "t_off": 16.42
   },
   {
    "text": "संविद्रूपमवेक्ष्य किं न रमसे तद्भावनानिर्भरः ॥",
    "t_on": 16.42,
    "t_off": 21.893
   }
  ]
 },
 {
  "id": "anuttara_06",
  "meter": "shardulavikridita",
  "dur": 21.774,
  "padas": [
   {
    "text": "पूर्वाभावभवक्रिया हि सहसा भावाः सदाऽस्मिन्भवे",
    "t_on": 0.0,
    "t_off": 5.444
   },
   {
    "text": "मध्याकारविकारसंकरवतां तेषां कुतः सत्यता ।",
    "t_on": 5.444,
    "t_off": 10.887
   },
   {
    "text": "निःसत्ये चपले प्रपञ्चनिचये स्वप्नभ्रमे पेशले",
    "t_on": 10.887,
    "t_off": 16.331
   },
   {
    "text": "शङ्कातङ्ककलङ्कयुक्तिकलनातीतः प्रबुद्धो भव ॥",
    "t_on": 16.331,
    "t_off": 21.774
   }
  ]
 },
 {
  "id": "anuttara_07",
  "meter": "shardulavikridita",
  "dur": 22.63,
  "padas": [
   {
    "text": "भावानां न समुद्भवोऽस्ति सहजस्त्वद्भाविता भान्त्यमी",
    "t_on": 0.0,
    "t_off": 5.657
   },
   {
    "text": "निःसत्या अपि सत्यतामनुभवभ्रान्त्या भजन्ति क्षणम् ।",
    "t_on": 5.657,
    "t_off": 11.315
   },
   {
    "text": "त्वत्संकल्पज एष विश्वमहिमा नास्त्यस्य जन्मान्यतः",
    "t_on": 11.315,
    "t_off": 16.973
   },
   {
    "text": "तस्मात्त्वं विभवेन भासि भुवनेष्वेकोप्यनेकात्मकः ॥",
    "t_on": 16.973,
    "t_off": 22.63
   }
  ]
 },
 {
  "id": "anuttara_08",
  "meter": "shardulavikridita",
  "dur": 21.274,
  "padas": [
   {
    "text": "यत्सत्यं यदसत्यमल्पबहुलं नित्यं न नित्यं च यत्",
    "t_on": 0.0,
    "t_off": 5.319
   },
   {
    "text": "यन्मायामलिनं यदात्मविमलं चिद्दर्पणे राजते ।",
    "t_on": 5.319,
    "t_off": 10.637
   },
   {
    "text": "तत्सर्वं स्वविमर्शसंविदुदयाद् रूपप्रकाशात्मकं",
    "t_on": 10.637,
    "t_off": 15.956
   },
   {
    "text": "ज्ञात्वा स्वानुभवाधिरूढमहिमा विश्वेश्वरत्वं भज ॥",
    "t_on": 15.956,
    "t_off": 21.274
   }
  ]
 }
