[
 {
  "id": "bhairava_01",
  "meter": "rathoddhata",
  "dur": 12.37,
  "padas": [
   {
    "text": "व्याप्तचराचरभावविशेषं चिन्मयमेकमनन्तमनादिम् ।",
    "t_on": 0.02,
    "t_off": 5.787
   },
   {
    "text": "भैरवनाथमनाथशरण्यं त्वन्मयचित्ततया हृदि वन्दे ॥",
    "t_on": 6.635,
    "t_off": 12.37
   }
  ]
 },
 {
  "id": "bhairava_02",
  "meter": "rathoddhata",
  "dur": 12.694,
  "padas": [
   {
    "text": "त्वन्मयमेतदशेषमिदानीं भाति मम त्वदनुग्रहशक्त्या ।",
    "t_on": 0.0,
    "t_off": 6.347
   },
   {
    "text": "त्वं च महेश सदैव ममात्मा स्वात्ममयं मम तेन समस्तम् ॥",
    "t_on": 6.347,
    "t_off": 12.694
   }
  ]
 },
 {
  "id": "bhairava_03",
  "meter": "rathoddhata",
  "dur": 12.11,
  "padas": [
   {
    "text": "स्वात्मनि विश्वगते त्वयि नाथे तेन न संसृतिभीतिकथास्ति ।",
    "t_on": 0.0,
    "t_off": 6.055
   },
   {
    "text": "सत्स्वपि दुर्धरदुःखविमोहत्रासविधायिषु कर्मगणेषु ॥",
    "t_on": 6.055,
    "t_off": 12.11
   }
  ]
 },
 {
  "id": "bhairava_04",
  "meter": "rathoddhata",
  "dur": 12.07,
  "padas": [
   {
    "text": "अन्तक मां प्रति मा दृशमेनां क्रोधकरालतमां विनिधेहि ।",
    "t_on": 0.0,
    "t_off": 6.035
   },
   {
    "text": "शङ्करसेवनचिन्तनधीरो भीषणभैरवशक्तिमयोऽस्मि ॥",
    "t_on": 6.035,
    "t_off": 12.07
   }
  ]
 },
 {
  "id": "bhairava_05",
  "meter": "rathoddhata",
  "dur": 12.45,
  "padas": [
   {
    "text": "इत्थमुपोढभवन्मयसंविद्दीधितिदारितभूरितमिस्रः ।",
    "t_on": 0.0,
    "t_off": 6.225
   },
   {
    "text": "मृत्युयमान्तककर्मपिशाचैर्नाथ नमोऽस्तु न जातु बिभेमि ॥",
    "t_on": 6.225,
    "t_off": 12.45
   }
  ]
 },
 {
  "id": "bhairava_06",
  "meter": "rathoddhata",
  "dur": 12.01,
  "padas": [
   {
    "text": "प्रोदितसत्यविबोधमरीचिः प्रेक्षितविश्वपदार्थसतत्त्वः ।",
    "t_on": 0.0,
    "t_off": 6.005
   },
   {
    "text": "भावपरामृतनिर्भरपूर्णे त्वय्यहमात्मनि निर्वृतिमेमि ॥",
    "t_on": 6.005,
    "t_off": 12.01
   }
  ]
 },
 {
  "id": "bhairava_07",
  "meter": "rathoddhata",
  "dur": 11.75,
  "padas": [
   {
    "text": "मानसगोचरमेति यदैव क्लेशदशा तनुतापविधात्री ।",
    "t_on": 0.0,
    "t_off": 5.875
   },
   {
    "text": "नाथ तदैव मम त्वदभेदस्तोत्रपरामृतवृष्टिरुदेति ॥",
    "t_on": 5.875,
    "t_off": 11.75
   }
  ]
 },
 {
  "id": "bhairava_08",
  "meter": "rathoddhata",
  "dur": 12.574,
  "padas": [
   {
    "text": "शङ्कर सत्यमिदं व्रतदानस्नानतपो भवतापविदारि ।",
    "t_on": 0.0,
    "t_off": 6.287
   },
   {
    "text": "तावकशास्त्रपरामृतचिन्ता स्यन्दति चेतसि निर्वृतिधाराम् ॥",
    "t_on": 6.287,
    "t_off": 12.574
   }
  ]
 },
 {
  "id": "bhairava_09",
  "meter": "rathoddhata",
  "dur": 12.834,
  "padas": [
   {
    "text": "नृत्यति गायति हृष्यति गाढं संविदियं मम भैरवनाथ ।",
    "t_on": 0.0,
    "t_off": 6.417
   },
   {
    "text": "त्वां प्रियमाप्य सुदर्शनमेकं दुर्लभमन्यजनैः समयज्ञम् ॥",
    "t_on": 6.417,
    "t_off": 12.834
   }
  ]
 },
 {
  "id": "bhairava_10_phala",
  "meter": "gadya",
  "dur": 11.45,
  "padas": [
   {
    "text": "वसुरसपौषे कृष्णदशम्यामभिनवगुप्तः स्तवमिममकरोत् ।",
    "t_on": 0.0,
    "t_off": 5.725
   },
   {
    "text": "येन विभुर्भवमरुसन्तापं शमयति जनस्य झटिति दयालुः ॥",
    "t_on": 5.725,
    "t_off": 11.45
   }
  ]
 }
]