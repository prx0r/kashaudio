  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_21.wav"
 },
 {
  "id": "ajs_22",
  "meter": "gadya",
  "padas": [
   "नार्थव्यवस्था प्राणादाव्  अहंभावनिरोधतः ।",
