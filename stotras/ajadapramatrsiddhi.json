  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_22.wav"
 },
 {
  "id": "ajs_23",
  "meter": "gadya",
  "padas": [
   "उक्ता सैव च विश्रान्तिः  सर्वापेक्षानिरोधतः ।",
   "स्वातन्त्र्यम् अथ कर्तृत्वं ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_23.wav"
 },
 {
  "id": "ajs_24",
  "meter": "gadya",
  "padas": [
   "मायाभिदास् तच्छक्तेर् एव  चान्याप्रसिद्धितः ।",
   "तदख्यातिमयं ह्य् एतज् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_24.wav"
 },
 {
  "id": "ajs_25",
  "meter": "gadya",
  "padas": [
   "एकैव चानुसंधानात्  सा प्रोक्ता सर्वसंविदाम् ।",
   "स्वसंवेदनपर्याय- ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_25.wav"
 },
 {
  "id": "ajs_26",
  "meter": "gadya",
  "padas": [
   "भावव्यवस्था यन् निष्ठा  तस्याहंभावभागिनः ।",
   "व्यापित्वम् अनुसंधानं ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_26.wav"
 },
 {
  "id": "ajs_27",
  "meter": "gadya",
  "padas": [
