[
 {
  "id": "ajs_01",
  "meter": "anushtubh",
  "padas": [
   "यथा सदसताम् नैव  विशेषो ऽस्ति निजात्मनि ।",
   "जदाजडानाम् अप्य् एवं  नास्त्य् असाव् इति निश्चयः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_01.wav"
 },
 {
  "id": "ajs_02",
  "meter": "gadya",
  "padas": [
   "प्रख्योपाख्या च सत्ता यद्  यद् असत्ता विपर्ययः ।",
   "नैतत् स्वरूपं स्पृशति ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_02.wav"
 },
 {
  "id": "ajs_03",
  "meter": "gadya",
  "padas": [
   "प्रख्योपाख्याविषयताप्य्  अर्थस्यात्मा न युज्यते ।",
   "परापेक्षितया नैक- ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_03.wav"
 },
 {
  "id": "ajs_04",
  "meter": "gadya",
  "padas": [
   "मा भूद् विशेषः प्रख्यादि-  भावाभावौ ततः पुनः ।",
   "सिद्ध्यत्य् एव विशेषो ऽत्र ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_04.wav"
 },
 {
  "id": "ajs_05",
  "meter": "gadya",
  "padas": [
   "एवम् अप्य् अवभासानु-  षक्ता सत्तोचिता भवेत् ।",
   "तदपेक्षां विना भावा- ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_05.wav"
 },
 {
  "id": "ajs_06",
  "meter": "gadya",
  "padas": [
   "कथं स्याद् अविशेषो ऽत्र  यावतार्थक्रियां हि सन् ।",
   "कुर्यान् नान्यस् तथाप्य् अर्थो ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_06.wav"
 },
 {
  "id": "ajs_07",
  "meter": "gadya",
  "padas": [
   "एवम् अर्थक्रियाभासो-  पाधिसंभेदम् आगतः ।",
   "सन्न् अर्थः स्यात् स्वरूपेण ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_07.wav"
 },
 {
  "id": "ajs_08",
  "meter": "gadya",
  "padas": [
   "तत्राप्य् अर्थक्रिया सिद्ध-  सत्ताकार्थे न वर्णिता ।",
   "समम् एवानयोस् तेन ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_08.wav"
 },
 {
  "id": "ajs_09",
  "meter": "gadya",
  "padas": [
   "संविद् अप्य् अपरामर्श-  रूपा चेत् तद् असाव् अपि ।",
   "अभावेन जडेनाथ ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_09.wav"
 },
 {
  "id": "ajs_10",
  "meter": "gadya",
  "padas": [
   "सैवं भूतात्मना स्वेनाप्य्  अलब्धपरिनिष्ठितिः ।",
   "कथम् अन्यस्य भावस्य ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_10.wav"
 },
 {
  "id": "ajs_11",
  "meter": "gadya",
  "padas": [
   "इदम् इत्य् उचितः संवित्  प्रकाशे ऽन्यस्य वस्तुनः ।",
   "प्रतिष्ठात्मकतां गच्छेद् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_11.wav"
 },
 {
  "id": "ajs_12",
  "meter": "gadya",
  "padas": [
   "व्यतिरेकेतराभ्याम् हि  निश्चयो ऽन्यजडात्मनोः ।",
   "व्यवस्थितिः प्रतिष्ठा च ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_12.wav"
 },
 {
  "id": "ajs_13",
  "meter": "gadya",
  "padas": [
   "एवम् आत्मन्य् असत्कल्पाः  प्रकाशस्यैव सन्त्य् अमी ।",
   "जडाः प्रकाश एवास्ति ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_13.wav"
 },
 {
  "id": "ajs_14",
  "meter": "gadya",
  "padas": [
   "न चैवानुभवो ऽप्य् अस्ति  भिन्नाभिन्नविनिश्चयम् ।",
   "मुक्त्वान्वयस्य प्रकाशस्य ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_14.wav"
 },
 {
  "id": "ajs_15",
  "meter": "gadya",
  "padas": [
   "इदम् इत्य् अस्य विच्छिन्न-  विमर्शस्य कृतार्थता ।",
   "या स्वस्वरूपे विश्रान्तिर् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_15.wav"
 },
 {
  "id": "ajs_16",
  "meter": "gadya",
  "padas": [
   "द्विधा स एष एवात्मा  मितो ऽपरिमितस् तथा ।",
   "प्राणादिना निरुद्धो ऽणुः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_16.wav"
 },
 {
  "id": "ajs_17",
  "meter": "gadya",
  "padas": [
   "उभयो ऽप्य् एष पर्यन्त-  भूमिः सर्वार्थसंविदाम् ।",
   "एक एवानुसन्धानाद् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_17.wav"
 },
 {
  "id": "ajs_18",
  "meter": "gadya",
  "padas": [
   "न चाप्य् अव्यतिरेकात्म-  विमर्शात्मन्य् अहंविदि ।",
   "भाति पर्यन्तवर्तिन्यां ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_18.wav"
 },
 {
  "id": "ajs_19",
  "meter": "gadya",
  "padas": [
   "न सिद्धो ऽप्रथनाद् एव  ज्ञानादिसमवाय्य् अपि ।",
   "तत् प्राणादि प्रमेयं स्यान् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_19.wav"
 },
 {
  "id": "ajs_20",
  "meter": "gadya",
  "padas": [
   "यद्य् अप्य् अर्थस्थितिः प्राण-  पुर्यष्टकनियन्त्रिते ।",
   "जीवे निरुद्धा तत्रापि ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/ajs_20.wav"
 },
 {
  "id": "ajs_21",
  "meter": "gadya",
  "padas": [
   "तदात्मनैव तस्य स्यात्  कथं प्राणेन यन्त्रणा ।",
