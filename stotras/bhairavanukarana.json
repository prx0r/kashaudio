  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_11.wav"
 },
 {
  "id": "bna_12",
  "meter": "gadya",
  "padas": [
   "दहनजलामृतलेखाविषादि बिभ्रत् त्वम् आदिशस्य् एतत् ।",
   "विश्वं विरुद्धम् अपि सच्चिद्रूपे मयि विरुध्यते नैतत् ॥"
