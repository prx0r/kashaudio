[
 {
  "id": "bna_01",
  "meter": "gadya",
  "padas": [
   "चितिभूमिसमाश्रयणाश् चितिभूतिं श्रयत मा मुधा भ्रमत ।",
   "प्रथयन्न् इति भक्तिमतां जयति शिवो ऽनुग्रहप्रवणः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_01.wav"
 },
 {
  "id": "bna_02",
  "meter": "gadya",
  "padas": [
   "चिद्भैरवम् एव परं परमामृतरूपम् एकम् अतिदीप्तम् ।",
   "उल्लसितकरणचक्रग्रस्तसमस्तं शिवं वन्दे ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_02.wav"
 },
 {
  "id": "bna_03",
  "meter": "gadya",
  "padas": [
   "स्तुत्यः स्तोता स्तुतिर् इति यद् अपि विभिन्नं न किंचिद् अस्तीह ।",
   "मृषति यथा यद् रूपं चिद्रूपतया तथा भवत्य् एतत् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_03.wav"
 },
 {
  "id": "bna_04",
  "meter": "gadya",
  "padas": [
   "विगलितसर्वविभेदं सर्वविभेदात्म चिद्घनानन्दम् ।",
   "यत् तव तत्त्वं भगवंस् तस्यानुकृतिं त्वदाकृतिं वन्दे ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_04.wav"
 },
 {
  "id": "bna_05",
  "meter": "gadya",
  "padas": [
   "रेखापुरुषः पुरुषं वर्णलिपिर् वर्णसंचयं यद्वत् ।",
   "तद्वत् विचित्ररूपं त्वाम् आकारो व्यनक्ति परमात्मन् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_05.wav"
 },
 {
  "id": "bna_06",
  "meter": "gadya",
  "padas": [
   "तत्राविकल्पम् एव त्वां चिद्रूपं समाविश्य ।",
