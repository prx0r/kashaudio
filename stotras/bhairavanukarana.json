  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_13.wav"
 },
 {
  "id": "bna_14",
  "meter": "gadya",
  "padas": [
   "पश्यत पश्यत पाशा विषमास् त इमे बहिष्कृताः शश्वत् ।",
   "इत्य् अन्त्रधारणमिषत् कथयंस् त्वं नः समाभासि ॥"
