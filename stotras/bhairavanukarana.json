  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_12.wav"
 },
 {
  "id": "bna_13",
  "meter": "gadya",
  "padas": [
   "संवित्सूत्रनिलीनो निःसारो मातृनिवहो ऽयम् ।",
