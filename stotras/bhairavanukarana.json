  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_06.wav"
 },
 {
  "id": "bna_07",
  "meter": "gadya",
  "padas": [
   "स्वात्मप्रभां विधाय वाग्देवीं विषयकुसुमकॢप्तार्चः ।",
   "प्रथमोन्मेषं गुरुम् अथ वन्दित्वा हृदयम् आविश्य ॥"
