  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_08.wav"
 },
 {
  "id": "bna_09",
  "meter": "gadya",
  "padas": [
   "चित्यानन्देच्छावित्करणाख्याः शक्तयो जयन्ति विभो ।",
