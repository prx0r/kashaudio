  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_07.wav"
 },
 {
  "id": "bna_08",
  "meter": "gadya",
  "padas": [
   "स्तौमि विमृशन् महेश्वरम् आत्मानं स्वं चिदेकघनम् ।",
   "स्रावितपाशकदम्बकम् एतस्मिन् देहदेवगृहे ॥"
