  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_09.wav"
 },
 {
  "id": "bna_10",
  "meter": "gadya",
  "padas": [
   "सर्वज्ञतादिविषयं हृदयादिकम् अङ्गषट्कं ते ।",
   "सकलं सदाशिवान्तं प्रेतात्मतया तवासनं स्वामिन् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/bna_10.wav"
 },
 {
  "id": "bna_11",
  "meter": "gadya",
  "padas": [
   "परमप्रकाशवपुषो विमर्शशक्तिः प्रभो परा देवी ।",
