[
 {
  "id": "tsa_01",
  "meter": "gadya",
  "padas": [
   "यदयमनुत्तरमूर्तिर्नजेच्छयाखिलमिदं जगत्स्रष्टुम्। पस्पन्दे स ।",
   "स्पन्दः प्रथमः शिवतत्त्वमुच्यते तज्ज्ञैः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_01.wav"
 },
 {
  "id": "tsa_02",
  "meter": "gadya",
  "padas": [
   "इच्छा सैव स्वच्छा सन्ततसमवायिनी सती ।",
   "शक्तिः। सचराचरस्य जगतो बीजं निखिलस्य निजनिलीनस्य ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_02.wav"
 },
 {
  "id": "tsa_03",
  "meter": "gadya",
  "padas": [
   "स्वेच्छाशक्त्युद्गीर्णं जगदात्मतया समाच्छाद्य। निवसन् ।",
   "स एव निखिलानुग्रहनिरतः सदाशिवोऽभिहितः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_03.wav"
 },
 {
  "id": "tsa_04",
  "meter": "gadya",
  "padas": [
   "विश्वं पश्चात्पश्यनिदन्तया निखिलमीश्वरो जातः ।",
   "सा भवति शुद्धविद्या येदन्ताहन्तयोरभेदमतिः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_04.wav"
 },
 {
  "id": "tsa_05",
  "meter": "gadya",
  "padas": [
   "माया विभेदबुद्धिर्निजांशजातेषु निखिलजीवेषु। नित्यं ।",
   "तस्य निरङ्कुशविभवं वेलेव वारिधे रुन्धे ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_05.wav"
 },
 {
  "id": "tsa_06",
  "meter": "gadya",
  "padas": [
   "स तया परिमितमूर्तिः सङ्कुचितसमस्तशक्तिरेष ।",
   "पुमान्। रविरिव सन्ध्यारक्तः संहृतशक्तिः स्वभासनेऽप्यपटुः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_06.wav"
 },
 {
  "id": "tsa_07",
  "meter": "gadya",
  "padas": [
   "सम्पूर्णकर्तृताद्या बह्व्यः सन्त्यस्य ।",
   "शक्तयस्तस्य। सङ्कोचात्सङ्कुचिताः कलादिरूपेण रूढयन्त्येवम् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_07.wav"
 },
 {
  "id": "tsa_08",
  "meter": "gadya",
  "padas": [
   "तत्सर्वकर्तृता सा सङ्कुचिता कतिपयार्थमात्रपरा ।",
   "किञ्चित्कर्तारममुं कलयन्ती कीर्त्यते कला नाम ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_08.wav"
 },
 {
  "id": "tsa_09",
  "meter": "gadya",
  "padas": [
   "सर्वज्ञतास्य शक्तिः परिमिततनुरल्पवेद्यमात्रपरा ।",
   "ज्ञानमुत्पादयन्ती विद्येति निगद्यते बुधैराद्यैः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_09.wav"
 },
 {
  "id": "tsa_10",
  "meter": "gadya",
  "padas": [
   "नित्यपरिपूर्णतृप्तिः शक्तिस्तस्यैव परिमिता तु सती ।",
   "भोगेषु रञ्जयन्ती सततममुं रागतत्त्वतां याता ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_10.wav"
 },
 {
  "id": "tsa_11",
  "meter": "gadya",
  "padas": [
   "सा नित्यतास्य शक्तिर्निकृष्य ।",
   "निधनोदयप्रदानेन। नियतपरिच्छेदकरी कॢप्ता स्यात्कालतत्त्वरूपेण ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_11.wav"
 },
 {
  "id": "tsa_12",
  "meter": "gadya",
  "padas": [
   "यास्य स्वतन्त्रताख्या शक्तिः सङ्कोचशालिनी ।",
   "सैव। कृत्याकृत्येष्ववशं नियतममुं नियमयन्त्यभून्नियतिः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_12.wav"
 },
 {
  "id": "tsa_13",
  "meter": "gadya",
  "padas": [
   "इच्छादित्रिसमष्टिः शक्तिः शान्तास्य ।",
   "सङ्कुचद्रूपा। सङ्कलितेच्छाद्यात्मकसत्त्वादिकसाम्यरूपिणी तु सती ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_13.wav"
 },
 {
  "id": "tsa_14",
  "meter": "gadya",
  "padas": [
   "बुद्ध्यादिसामरस्यस्वरूपचित्तात्मिका मता ।",
   "प्रकृतिः। इच्छास्य रजोरूपाहङ्कृतिरासीदहम्प्रतीतिकरी ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_14.wav"
 },
 {
  "id": "tsa_15",
  "meter": "gadya",
  "padas": [
   "सत्त्वपरिणामिनी ज्ञानशक्तिरेवार्थाध्यवसायलक्षणा बुद्धिः ।",
   "तमःपरिणामिनी क्रियाशक्तिः। विकल्पकरणलक्षणं मनस्तत्त्वमुच्यते ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_15.wav"
 },
 {
  "id": "tsa_16",
  "meter": "gadya",
  "padas": [
   "वामादिपञ्चभेदः स एव ।",
   "सङ्कुचितविग्रहो देवः। ज्ञानक्रियोपरागप्राधान्याद्विविधविषयरूपोऽभूत् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_16.wav"
 },
 {
  "id": "tsa_17",
  "meter": "gadya",
  "padas": [
   "श्रोत्रं चक्षुः स्पर्शनजिह्वाघ्राणानि बोधकरणानि ।",
   "शब्दस्पर्शौ रूपं रसगन्धौ चेति भूतसूक्ष्माणि ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_17.wav"
 },
 {
  "id": "tsa_18",
  "meter": "gadya",
  "padas": [
   "अयमेवातिनिकृष्टो जातो भूतात्मनापि भूतेशः ।",
   "गगनमनिलश्च तेजः सलिलं भूमिश्च पञ्चभूतानि ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_18.wav"
 },
 {
  "id": "tsa_19",
  "meter": "gadya",
  "padas": [
   "श्रोत्रादिकरणवेद्याः शब्दाद्यास्तानि वेदकान्येषाम्। वचनकरी ।",
   "वागासीत् पाणिः स्यात्करणभूत आदाने ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_19.wav"
 },
 {
  "id": "tsa_20",
  "meter": "gadya",
  "padas": [
   "गमनविसर्गानन्दत्रितये पादादिकं करणम् ।",
   "गन्धवती भूमिः स्यादापः सांसिद्धिकद्रवास्तेजः ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_20.wav"
 },
 {
  "id": "tsa_21",
  "meter": "gadya",
  "padas": [
   "उष्णस्पर्शमरूपस्पर्शो वायुरम्बरं सशब्दम्। षट्त्रिंशत्तत्त्वमयं ।",
   "वन्दे कौलं कुलातिगं शम्भुम् ॥"
  ],
  "seed": 60,
  "no_sandhi": false,
  "out": "out/tsa_21.wav"
 }
